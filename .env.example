# Server only. Never use a VITE_ prefix for this key.
GEMINI_API_KEY=
# Optional voice (default Achird). Young-sounding picks: Achird, Puck, Fenrir,
# Sadachbia, Zubenelgenubi, Umbriel. Audition without restarting: open /?voice=Puck#connect
GEMINI_VOICE=Achird
# PostHog (public by design). Analytics stay off until the key is set.
# Use https://eu.i.posthog.com for an EU project.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
